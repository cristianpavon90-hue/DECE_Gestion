<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/text_derivacion_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/derivacion_details_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Nombre del Estudiante -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/new_form_student_name">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_student_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName|textCapWords" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Grado / Curso -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_grado"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/new_form_grado">
            <AutoCompleteTextView
                android:id="@+id/edit_grado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/new_form_grado"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Paralelo -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_paralelo"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/new_form_paralelo">
            <AutoCompleteTextView
                android:id="@+id/edit_paralelo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/new_form_paralelo"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Fecha del Documento -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/doc_date_hint">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_doc_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>
</ScrollView>
