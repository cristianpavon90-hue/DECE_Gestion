<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_background"
    android:padding="24dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/text_help_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/help_title"
            android:textColor="@color/black"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/text_help_intro"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/help_intro"
            android:textColor="@color/text_gray"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/text_help_title" />

        <!-- Item 1: Perfil -->
        <ImageView
            android:id="@+id/icon_step1"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="24dp"
            android:contentDescription="@null"
            android:src="@android:drawable/ic_menu_edit"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/text_help_intro"
            app:tint="@color/blue_background" />

        <TextView
            android:id="@+id/text_step1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/help_step1"
            android:textColor="@color/black"
            app:layout_constraintBottom_toBottomOf="@id/icon_step1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/icon_step1"
            app:layout_constraintTop_toTopOf="@id/icon_step1" />

        <!-- Item 2: Registro -->
        <ImageView
            android:id="@+id/icon_step2"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="24dp"
            android:contentDescription="@null"
            android:src="@android:drawable/ic_menu_add"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/text_step1"
            app:tint="@color/blue_background" />

        <TextView
            android:id="@+id/text_step2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/help_step2"
            android:textColor="@color/black"
            app:layout_constraintBottom_toBottomOf="@id/icon_step2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/icon_step2"
            app:layout_constraintTop_toTopOf="@id/icon_step2" />

        <!-- Item 3: Seguimiento -->
        <ImageView
            android:id="@+id/icon_step3"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="24dp"
            android:contentDescription="@null"
            android:src="@android:drawable/ic_popup_reminder"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/text_step2"
            app:tint="@color/blue_background" />

        <TextView
            android:id="@+id/text_step3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/help_step3"
            android:textColor="@color/black"
            app:layout_constraintBottom_toBottomOf="@id/icon_step3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/icon_step3"
            app:layout_constraintTop_toTopOf="@id/icon_step3" />

        <!-- Item 4: Base de Datos -->
        <ImageView
            android:id="@+id/icon_step4"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="24dp"
            android:contentDescription="@null"
            android:src="@android:drawable/ic_menu_save"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/text_step3"
            app:tint="@color/blue_background" />

        <TextView
            android:id="@+id/text_step4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/help_step4"
            android:textColor="@color/black"
            app:layout_constraintBottom_toBottomOf="@id/icon_step4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/icon_step4"
            app:layout_constraintTop_toTopOf="@id/icon_step4" />

        <!-- Item 5: Widget -->
        <ImageView
            android:id="@+id/icon_step5"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="24dp"
            android:contentDescription="@null"
            android:src="@android:drawable/ic_menu_today"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/text_step4"
            app:tint="@color/blue_background" />

        <TextView
            android:id="@+id/text_step5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/help_step5"
            android:textColor="@color/black"
            app:layout_constraintBottom_toBottomOf="@id/icon_step5"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/icon_step5"
            app:layout_constraintTop_toTopOf="@id/icon_step5" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_close_help"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/help_close"
            android:textAllCaps="false"
            app:cornerRadius="8dp"
            app:layout_constraintTop_toBottomOf="@id/text_step5" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
