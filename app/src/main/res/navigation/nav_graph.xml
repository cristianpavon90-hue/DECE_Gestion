<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/FirstFragment">

    <fragment
        android:id="@+id/FirstFragment"
        android:name="com.example.decegestin.FirstFragment"
        android:label="@string/first_fragment_label"
        tools:layout="@layout/fragment_first">

        <action
            android:id="@+id/action_FirstFragment_to_SecondFragment"
            app:destination="@id/SecondFragment"
            app:popUpTo="@id/FirstFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_FirstFragment_to_RegisterFragment"
            app:destination="@id/RegisterFragment" />
        <action
            android:id="@+id/action_FirstFragment_to_PendingApprovalFragment"
            app:destination="@id/PendingApprovalFragment" />
    </fragment>
    <fragment
        android:id="@+id/RegisterFragment"
        android:name="com.example.decegestin.RegisterFragment"
        android:label="Registro"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_RegisterFragment_to_SecondFragment"
            app:destination="@id/SecondFragment"
            app:popUpTo="@id/RegisterFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_RegisterFragment_to_PendingApprovalFragment"
            app:destination="@id/PendingApprovalFragment"
            app:popUpTo="@id/RegisterFragment"
            app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/PendingApprovalFragment"
        android:name="com.example.decegestin.PendingApprovalFragment"
        android:label="Cuenta Pendiente"
        tools:layout="@layout/fragment_pending_approval">
        <action
            android:id="@+id/action_PendingApprovalFragment_to_SecondFragment"
            app:destination="@id/SecondFragment"
            app:popUpTo="@id/PendingApprovalFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_PendingApprovalFragment_to_FirstFragment"
            app:destination="@id/FirstFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/SecondFragment"
        android:name="com.example.decegestin.SecondFragment"
        android:label="@string/second_fragment_label"
        tools:layout="@layout/fragment_second">

        <action
            android:id="@+id/action_SecondFragment_to_DetailFragment"
            app:destination="@id/DetailFragment" />
        <action
            android:id="@+id/action_SecondFragment_to_ProfileFragment"
            app:destination="@id/ProfileFragment" />
        <action
            android:id="@+id/action_SecondFragment_to_ChangePasswordFragment"
            app:destination="@id/ChangePasswordFragment" />
        <action
            android:id="@+id/action_SecondFragment_logout"
            app:destination="@id/FirstFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_SecondFragment_to_BitacoraFragment"
            app:destination="@id/BitacoraFragment" />
        <action
            android:id="@+id/action_SecondFragment_to_NewFormFragment"
            app:destination="@id/NewFormFragment" />
        <action
            android:id="@+id/action_SecondFragment_to_DistritalRiskDetailFragment"
            app:destination="@id/DistritalRiskDetailFragment" />
    </fragment>
    <fragment
        android:id="@+id/BitacoraFragment"
        android:name="com.example.decegestin.BitacoraFragment"
        android:label="Bitácora"
        app:launchSingleTop="true"
        tools:layout="@layout/fragment_bitacora" />
    <fragment
        android:id="@+id/DocsFragment"
        android:name="com.example.decegestin.DocsFragment"
        android:label="Documentación"
        app:launchSingleTop="true"
        tools:layout="@layout/fragment_docs">
        <action
            android:id="@+id/action_DocsFragment_to_RepoDetailFragment"
            app:destination="@id/RepoDetailFragment" />
        <action
            android:id="@+id/action_DocsFragment_to_PdfViewerFragment"
            app:destination="@id/PdfViewerFragment" />
    </fragment>
    <fragment
        android:id="@+id/RepoDetailFragment"
        android:name="com.example.decegestin.RepoDetailFragment"
        android:label="Repositorio"
        tools:layout="@layout/fragment_repo_detail">
        <action
            android:id="@+id/action_RepoDetailFragment_to_PdfViewerFragment"
            app:destination="@id/PdfViewerFragment" />
    </fragment>
    <fragment
        android:id="@+id/PdfViewerFragment"
        android:name="com.example.decegestin.PdfViewerFragment"
        android:label="Visor PDF"
        tools:layout="@layout/fragment_pdf_viewer" />
    <fragment
        android:id="@+id/ProfileFragment"
        android:name="com.example.decegestin.ProfileFragment"
        android:label="Mi Perfil"
        tools:layout="@layout/fragment_profile" />
    <fragment
        android:id="@+id/ChangePasswordFragment"
        android:name="com.example.decegestin.ChangePasswordFragment"
        android:label="Cambiar Contraseña"
        tools:layout="@layout/fragment_change_password" />
    <fragment
        android:id="@+id/DetailFragment"
        android:name="com.example.decegestin.DetailFragment"
        android:label="Detail"
        tools:layout="@layout/fragment_detail">
        <argument
            android:name="title"
            app:argType="string" />
    </fragment>
    <fragment
        android:id="@+id/NewFormFragment"
        android:name="com.example.decegestin.NewFormFragment"
        android:label="Nuevo Formulario"
        tools:layout="@layout/fragment_new_form" />
    <fragment
        android:id="@+id/NotificationManagerFragment"
        android:name="com.example.decegestin.NotificationManagerFragment"
        android:label="Recordatorios"
        tools:layout="@layout/fragment_notification_manager" />
    <fragment
        android:id="@+id/HistoryFragment"
        android:name="com.example.decegestin.HistoryFragment"
        android:label="Histórico"
        tools:layout="@layout/fragment_history">
        <action
            android:id="@+id/action_HistoryFragment_to_HistorySummaryFragment"
            app:destination="@id/HistorySummaryFragment" />
    </fragment>
    <fragment
        android:id="@+id/HistorySummaryFragment"
        android:name="com.example.decegestin.HistorySummaryFragment"
        android:label="@string/history_summary_title"
        tools:layout="@layout/fragment_history_summary" />
    <fragment
        android:id="@+id/EducandoFragment"
        android:name="com.example.decegestin.EducandoFragment"
        android:label="@string/educando_title"
        tools:layout="@layout/fragment_educando" />
    <fragment
        android:id="@+id/SexualViolenceDbFragment"
        android:name="com.example.decegestin.SexualViolenceDbFragment"
        android:label="@string/menu_sexual_violence_db"
        tools:layout="@layout/fragment_sexual_violence_db">
        <action
            android:id="@+id/action_SexualViolenceDbFragment_to_SexualViolenceDetailFragment"
            app:destination="@id/SexualViolenceDetailFragment" />
    </fragment>
    <fragment
        android:id="@+id/SexualViolenceDetailFragment"
        android:name="com.example.decegestin.SexualViolenceDetailFragment"
        android:label="Detalle Violencia Sexual"
        tools:layout="@layout/fragment_sexual_violence_detail" />
    <fragment
        android:id="@+id/ProfesionalesApprovalFragment"
        android:name="com.example.decegestin.ProfesionalesApprovalFragment"
        android:label="Aprobación de Profesionales"
        tools:layout="@layout/fragment_profesionales_approval" />
    <fragment
        android:id="@+id/InstitucionesCatalogFragment"
        android:name="com.example.decegestin.InstitucionesCatalogFragment"
        android:label="Catálogo de Instituciones y Circuitos"
        tools:layout="@layout/fragment_instituciones_catalog" />
    <fragment
        android:id="@+id/GeneracionReportesFragment"
        android:name="com.example.decegestin.GeneracionReportesFragment"
        android:label="Generación de Reportes"
        tools:layout="@layout/fragment_generacion_reportes" />
    <fragment
        android:id="@+id/DistritalRiskDetailFragment"
        android:name="com.example.decegestin.DistritalRiskDetailFragment"
        android:label="Desglose Institucional"
        tools:layout="@layout/fragment_distrital_risk_detail">
        <argument
            android:name="riskTitle"
            app:argType="string" />
        <argument
            android:name="filterType"
            app:argType="string" />
    </fragment>
    <fragment
        android:id="@+id/InstitutionalDistributionFragment"
        android:name="com.example.decegestin.InstitutionalDistributionFragment"
        android:label="Distribución Institucional"
        tools:layout="@layout/fragment_institutional_distribution" />
</navigation>