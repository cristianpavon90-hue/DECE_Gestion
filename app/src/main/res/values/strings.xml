    <!-- Tutorials for All Screens -->
    <string name="tut_dashboard_step1">Toca aquí para abrir el menú lateral y navegar a todos los módulos de la aplicación.</string>
    <string name="tut_dashboard_step2">Usa el botón "+" para crear rápidamente un nuevo formulario o abrir un expediente de atención.</string>
    <string name="tut_dashboard_step3">Accede a tu perfil para configurar tu institución, color personal y opciones de Coordinador.</string>
    <string name="tut_dashboard_step4">Toca cualquier categoría para ingresar al numerador y marcar nuevos números de documentos.</string>

    <string name="tut_form_step1">Completa los nombres del estudiante, grado, fecha y tipo de caso (Violencia sexual desplegará alertas especializadas).</string>
    <string name="tut_form_step2">Selecciona la categoría de quien deriva y elige un nombre del catálogo inteligente.</string>
    <string name="tut_form_step3">Si el caso lo requiere, ingresa los datos del representante para programar recordatorios automáticos.</string>
    <string name="tut_form_step4">Presiona "Guardar Formulario" para registrar el expediente en la nube al instante.</string>

    <string name="tut_history_step1">Filtra tus registros usando estas pestañas: Todos, Solo Estudiantes o Resto de Datos.</string>
    <string name="tut_history_step2">Toca cualquier tarjeta para editar los datos o presiona el tacho para eliminar.</string>
    <string name="tut_history_step3">Presiona "Resumen Estadístico" para consultar gráficos y reportes consolidados.</string>

    <string name="tut_sex_db_step1">Esta lista muestra todos los estudiantes registrados con casos de Violencia Sexual.</string>
    <string name="tut_sex_db_step2">Toca la tarjeta de un estudiante para abrir su expediente acumulativo y ver todos sus seguimientos.</string>

    <string name="tut_sex_detail_step1">Filtra por mes para consultar las acciones realizadas en ese periodo específico.</string>
    <string name="tut_sex_detail_step2">Presiona "Agregar Seguimiento" para registrar una nueva atención o hito en el caso.</string>
    <string name="tut_sex_detail_step3">Presiona "Compartir" para generar un reporte consolidado listo para enviar vía WhatsApp o email.</string>

    <string name="tut_educando_step1">Aquí se consolidan los puntajes y capacitaciones de Educando en Familia por docente y año.</string>
    <string name="tut_educando_step2">Presiona el botón "+" para agregar una nueva calificación de un docente.</string>

    <string name="tut_detail_step1">Toca una casilla gris sin marcar para asignar el número de documento y seleccionar la fecha.</string>
    <string name="tut_detail_step2">Si el documento es prioritario (Violencia, MSP, UDAI, Riesgo), el sistema te ofrecerá abrir o vincular un expediente.</string>
    <string name="tut_detail_step3">Presiona el icono de la base de datos para consultar el historial completo de documentos registrados en este numerador.</string>

    <string name="tut_docs_step1">Explora las secciones de Rutas y Protocolos, Acuerdos o Plantillas para acceder a los archivos en PDF.</string>
    <string name="tut_docs_step2">Toca un documento para leerlo, buscar palabras clave dentro del texto o imprimirlo.</string>
    <string name="tut_docs_step3">Si eres Coordinador/a, presiona "Agregar archivos" para registrar nuevos enlaces externos a documentos PDF.</string>

