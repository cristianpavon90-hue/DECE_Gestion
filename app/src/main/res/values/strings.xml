    <!-- Help Dialog -->
    <string name="help_title">Guía de Uso - DECE Gestión</string>
    <string name="help_intro">Bienvenido a la plataforma colaborativa de gestión institucional. Aquí puedes:</string>
    <string name="help_step1">1. Perfil y Personalización: Configura tu institución y elige un color personal. Esto es vital para organizar tus datos y los de tus compañeros.</string>
    <string name="help_step2">2. Registro de Atenciones: Usa el "Nuevo Formulario" para registrar casos y protocolos. Incluye alertas especiales para Violencia Sexual.</string>
    <string name="help_step3">3. Seguimiento y Alertas: Recibe notificaciones automáticas de seguimiento con botones directos para contactar vía WhatsApp o llamada.</string>
    <string name="help_step4">4. Base de Datos / Histórico: Consulta y agrupa casos por grado. Puedes editar o eliminar registros; todo se sincroniza en la nube al instante.</string>
    <string name="help_step5">5. Widget de Escritorio: Agrega el widget a tu pantalla de inicio para acceder rápidamente a formularios y ver los contadores de tu institución en tiempo real.</string>
    <string name="help_close">Entendido</string>

